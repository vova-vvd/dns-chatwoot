<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <% cache([@portal, portal_content_version, request.host]) do %>
  <%# Portal home (per locale) %>
  <% home_alternates = portal_home_alternate_links(@portal) %>
  <% portal_locales(@portal).each do |locale| %>
    <url>
      <loc><%= portal_url(@portal, home_path_for(@portal, locale)) %></loc>
      <lastmod><%= @portal.updated_at.strftime("%Y-%m-%d") %></lastmod>
      <changefreq>weekly</changefreq>
      <priority>1.0</priority>
      <% home_alternates.each do |alt| %>
        <xhtml:link rel="alternate" hreflang="<%= alt[:hreflang] %>" href="<%= alt[:href] %>" />
      <% end %>
    </url>
  <% end %>

  <%# Categories that contain published articles %>
  <% @portal.categories.joins(:articles).merge(Article.published).group('categories.id').order(position: :asc)
            .includes(:associated_categories, root_category: :associated_categories).each do |category| %>
    <url>
      <loc><%= portal_url(@portal, category_path_for(@portal, category)) %></loc>
      <lastmod><%= category.updated_at.strftime("%Y-%m-%d") %></lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.8</priority>
      <% category_alternate_links(@portal, category).each do |alt| %>
        <xhtml:link rel="alternate" hreflang="<%= alt[:hreflang] %>" href="<%= alt[:href] %>" />
      <% end %>
    </url>
  <% end %>

  <%# Published articles %>
  <% @portal.articles.published.includes(:associated_articles, root_article: :associated_articles).each do |article| %>
    <url>
      <loc><%= portal_url(@portal, article_path_for(@portal, article)) %></loc>
      <lastmod><%= article.updated_at.strftime("%Y-%m-%d") %></lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.7</priority>
      <% article_alternate_links(@portal, article).each do |alt| %>
        <xhtml:link rel="alternate" hreflang="<%= alt[:hreflang] %>" href="<%= alt[:href] %>" />
      <% end %>
    </url>
  <% end %>
  <% end %>
</urlset>
